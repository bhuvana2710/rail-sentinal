    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n// Build a 12-reading window for the ML model\nconst sequence = Array.from({ length: 12 }, () => ({\n  motor_current_A: item.motor_current_A,\n  vibration_g: item.vibration_g,\n  temperature_C: item.temperature_C,\n}));\nreturn [{\n  json: {\n    // Original information\n    asset_id: item.asset_id,\n    timestamp: item.timestamp,\n    // Fields for Firebase \"readings\"\n    current: item.motor_current_A,\n    stationId: \"station01\",\n    temperature: item.temperature_C,\n    vibration: item.vibration_g,\n    // Data for Python ML\n    sequence: sequence,\n  }\n}];"
