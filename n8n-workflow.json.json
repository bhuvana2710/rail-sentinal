    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst stationId = $('Code in JavaScript').item.json.stationId;\n\n// Find which sensor had the biggest influence on the anomaly score\n// by comparing the absolute value of each SHAP contribution.\nconst shapEntries = Object.entries(item.shap || {});\n\nlet topSensor = null;\nlet topValue = -Infinity;\n\nfor (const [sensorName, contribution] of shapEntries) {\n  const magnitude = Math.abs(contribution);\n  if (magnitude > topValue) {\n    topValue = magnitude;\n    topSensor = sensorName;\n  }\n}\n\nreturn [{\n  json: {\n    assetId: item.asset_id,\n    stationId: stationId,\n    timestamp: item.timestamp,\n    anomalyScore: String(item.anomaly_score),\n    isAnomaly: String(item.is_anomaly),\n    trendRisk: item.trend_risk,\n    riskLevel: item.risk_level,\n    forecastHours: item.forecast_hours,\n    topSensor: topSensor,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
